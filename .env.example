# Application
PORT=3000
# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m

DATABASE_URL="${DB_TYPE}://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=${DB_SCHEMA}"
FRONTEND_URL='3000'
DB_TYPE="postgresql"
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="practise"
DB_SCHEMA="public"